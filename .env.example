# Copy this file to .env and fill in your values before running docker compose

# PostgreSQL credentials
POSTGRES_USER=bulaai
POSTGRES_PASSWORD=bulaai
POSTGRES_DB=bulaai

# Database connection string (used by backend)
# Docker-first: keep host as "postgres".
DATABASE_URL=postgresql+asyncpg://bulaai:bulaai@postgres:5432/bulaai

# PGQueuer CLI connection settings
PGHOST=postgres
PGPORT=5432
PGUSER=bulaai
PGPASSWORD=bulaai
PGDATABASE=bulaai

# Logging
# INFO shows per-stage RAG ingestion timings. DEBUG also shows per-section
# chunking detail; see the README RAG ingestion observability runbook.
LOG_LEVEL=INFO
JSON_LOGS=true  # Set to false for local development

# Environment
ENVIRONMENT=development
SQL_ECHO=false
SECRET_KEY=R9w2vY6mQ1tN5kX8pC3sD7fH0jL4zB9uA2eG6rT1yU5iO8nM3qW7xZ0cV4bK1pF
ACCESS_TOKEN_EXPIRE_MINUTES=30

MARITACA_API_KEY="Insert your Maritaca API key here"
MARITACA_MODEL=sabiazinho-4

# Chat LLM. Maritaca is the primary provider for the dense-only chat MVP.
LLM_PROVIDER=auto
LLM_ENABLE_FALLBACK=true
LLM_TIMEOUT_SECONDS=60

# OpenRouter powers both semantic chunking and OpenRouter embeddings.
# Leave OPENROUTER_API_KEY empty only when EMBEDDING_PROVIDER=ollama.
OPENROUTER_API_KEY="Insert your OpenRouter API key here"
OPENROUTER_CHAT_MODEL=openai/gpt-5.4-mini
OPENROUTER_CHUNK_MODEL=google/gemini-3-flash-preview
# Use a chat/instruct model here. Base models are not reliable for JSON chunking.
OPENROUTER_CHUNK_FALLBACK_MODEL=deepseek/deepseek-chat
OPENROUTER_REQUIRE_ZDR=true

# Dense embeddings
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# Local Ollama embedding provider
OLLAMA_HOST=http://host.docker.internal
OLLAMA_PORT=11434

# Qdrant vector store
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Keep false for local Docker/Qdrant HTTP. Set true for managed Qdrant behind TLS.
QDRANT_USE_HTTPS=false
QDRANT_API_KEY="Insert your Qdrant API key here"
QDRANT_TIMEOUT_SECONDS=60

# RAG semantic chunking
PROCESSING_CHUNK_TARGET_TOKENS=600
PROCESSING_CHUNK_MIN_TOKENS=200
PROCESSING_CHUNK_MAX_TOKENS=850
PROCESSING_CHUNK_OVERLAP_RATIO=0.12
PROCESSING_CHUNK_MAX_CONCURRENCY=4
PROCESSING_TOKENIZER_ENCODING=cl100k_base

# RAG ingestion debug artifacts
# Enable only during local/operator debugging. Files can include parsed leaflet text.
RAG_INGESTION_DEBUG=false
RAG_INGESTION_DEBUG_PATH=tmp/rag-ingestion-debug
